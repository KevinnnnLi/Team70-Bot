# Copy to env.sh (git-ignored), fill in the two keys, then load it with:
#   set -a; . ./env.sh; set +a
#
# The keys are issued by the Roostoo competition organisers. Never commit
# env.sh and never paste the keys into a chat, a commit, or a log file.
export ROOSTOO_API_KEY="replace-me"
export ROOSTOO_SECRET_KEY="replace-me"
export ROOSTOO_BASE_URL="https://mock-api.roostoo.com"
